# Copy to .env.local and fill. Never commit .env.local.
# cp .env.example .env.local

# LLM via OpenRouter (any OpenAI-compatible endpoint also works)
LLM_API_URL=https://openrouter.ai/api/v1/chat/completions
LLM_API_KEY=<your-openrouter-key>
# 3 free OpenRouter models layered: primary + 2 fallbacks tried in order on error/rate-limit.
LLM_MODEL=google/gemma-4-31b-it:free
LLM_MODEL_FALLBACKS=nvidia/nemotron-3-ultra-550b-a55b:free,nex-agi/nex-n2.5-pro:free

# Neon Postgres (share links + history + usage). Run migrations/0001_init.sql once against it.
DATABASE_URL=<your-neon-connection-string>

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
CHAIN_SECRET=<random-32-chars>

# Hold-gate (live). Testnet ARDRILL for now; switch to mainnet $ARIES at launch.
ARIES_TOKEN_ADDRESS=0x901fc7e22b7bc7353c66f0344a521e6533bf665f
HOOD_MAINNET_RPC=https://robinhood-sepolia-rpc.publicnode.com
# Same address, public copy for the wallet balance row.
NEXT_PUBLIC_ARIES_TOKEN=0x901fc7e22b7bc7353c66f0344a521e6533bf665f
