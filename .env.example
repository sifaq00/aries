# Copy to .env.local and fill secrets. Never commit .env.local.
# cp .env.example .env.local

# LLM (Mimo, OpenAI-compatible)
LLM_API_URL=https://token-plan-sgp.xiaomimimo.com/v1/chat/completions
LLM_API_KEY=<your-key>
LLM_MODEL=mimo-v2.5

# Supabase (share links + history + usage)
NEXT_PUBLIC_SUPABASE_URL=<your-url>
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-key>

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
CHAIN_SECRET=<random-32-chars>

# Hold-gate (opsi B). Empty = fee mode. Set to mainnet $ARIES to enable.
ARIES_TOKEN_ADDRESS=
HOOD_MAINNET_RPC=https://rpc.mainnet.chain.robinhood.com
HOLD_TIER1=10000
HOLD_TIER2=100000
NEXT_PUBLIC_ARIES_TOKEN=

# Fee per run (opsi C, testnet). Empty FEE_ENFORCED=0 disables.
HOOD_TESTNET_RPC=https://robinhood-sepolia-rpc.publicnode.com
FEE_VAULT_ADDRESS=
FEE_MIN_WEI=100000000000000
FEE_ENFORCED=1
